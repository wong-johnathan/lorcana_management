{
  "name": "lorcana-inventory-server",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npx prisma migrate deploy && npx tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "npx tsx prisma/seed.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "prisma": "^6.9.0",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
