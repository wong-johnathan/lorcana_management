generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id              String   @id @default(cuid())
  externalId      Int      @unique
  tcgPlayerId     Int?
  cardTraderUrl   String?
  cardmarketUrl   String?
  displayPrice    Float?
  name            String
  subtitle        String   @default("")
  character       String?
  types           String[]
  cardType        String   @default("")
  color           String
  setCode         String
  setNumber       Int?
  setName         String
  rarity          String
  inkCost         Int      @default(0)
  strength        Int      @default(0)
  willpower       Int      @default(0)
  lore            Int      @default(0)
  abilities       String   @default("")
  cardNumber      String   @default("")
  collectorNumber Int?
  foilTypes       String[] @default([])
  imageUrl        String   @default("")

  inventoryEntries       InventoryEntry[]
  analysis               CardAnalysis?
  prices                 CardPrice[]
  retentionOverrides     CardRetentionOverride[]
  extraForSaleListings   ExtraForSaleListing[]

  @@index([name])
  @@index([color])
  @@index([setName])
  @@index([setNumber])
  @@index([collectorNumber])
  @@index([rarity])
  @@index([tcgPlayerId])
  @@index([displayPrice])
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String?
  email           String?
  emailNormalized String?   @unique
  emailVerifiedAt DateTime?
  googleSub       String?   @unique
  authProvider    String    @default("LOCAL")
  publicEnabled   Boolean   @default(false)
  createdAt       DateTime  @default(now())

  inventoryEntries       InventoryEntry[]
  profile                UserProfile?
  references             UserReference[]
  inventoryPolicy        UserInventoryPolicy?
  cardRetentionOverrides CardRetentionOverride[]
  extraForSaleListings   ExtraForSaleListing[]
  marketplaceEnquiries    MarketplaceEnquiry[] @relation("MarketplaceBuyerEnquiries")
  enquiryMessages         EnquiryMessage[] @relation("MarketplaceMessageSender")
  enquiryOffers           EnquiryOffer[] @relation("MarketplaceOfferProposer")
  notifications           Notification[]
}

model UserInventoryPolicy {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keepNormalQuantity   Int      @default(4)
  keepFoilQuantity     Int      @default(1)
  keepHolofoilQuantity Int      @default(1)
  autoSuggestExtras    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model CardRetentionOverride {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId               String
  card                 Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  keepNormalQuantity   Int?
  keepFoilQuantity     Int?
  keepHolofoilQuantity Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

model ExtraForSaleListing {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant         String
  desiredQuantity     Int
  note                String?
  customPrice         Float?
  customPriceCurrency String  @default("SGD")
  pricingMode         String  @default("FIXED")
  status              String  @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  marketplaceEnquiries MarketplaceEnquiry[]
  marketplaceReservations MarketplaceReservation[]

  @@unique([userId, cardId, variant])
  @@index([userId])
  @@index([cardId])
  @@index([status])
}

model MarketplaceEnquiry {
  id             String              @id @default(cuid())
  listingId      String
  listing        ExtraForSaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User                @relation("MarketplaceBuyerEnquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  quantity       Int?
  status         String              @default("PENDING_SELLER")
  lastActivityAt DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages    EnquiryMessage[]
  offers      EnquiryOffer[]
  reservation MarketplaceReservation?

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
  @@index([lastActivityAt])
}

model EnquiryMessage {
  id        String             @id @default(cuid())
  enquiryId String
  enquiry   MarketplaceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User               @relation("MarketplaceMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime           @default(now())

  @@index([enquiryId])
  @@index([senderId])
  @@index([createdAt])
}

model EnquiryOffer {
  id                 String             @id @default(cuid())
  enquiryId          String
  enquiry            MarketplaceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  proposedByUserId   String
  proposedByUser     User               @relation("MarketplaceOfferProposer", fields: [proposedByUserId], references: [id], onDelete: Cascade)
  quantity           Int
  unitPriceMinor     Int
  currency           String
  createdAt          DateTime           @default(now())

  reservation MarketplaceReservation?

  @@index([enquiryId])
  @@index([proposedByUserId])
}

model MarketplaceReservation {
  id                 String              @id @default(cuid())
  listingId          String
  listing            ExtraForSaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  enquiryId          String              @unique
  enquiry            MarketplaceEnquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  acceptedOfferId    String?             @unique
  acceptedOffer      EnquiryOffer?       @relation(fields: [acceptedOfferId], references: [id], onDelete: SetNull)
  quantity           Int
  unitPriceMinor     Int
  currency           String
  expiresAt          DateTime
  status             String              @default("RESERVED")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([listingId])
  @@index([status])
  @@index([expiresAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  relatedType String?
  relatedId   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String?
  profileImageUrl       String?
  profileImageObjectKey String?
  countryOfResidence    String?
  instagram             String?
  instagramVisible      Boolean  @default(false)
  telegram              String?
  telegramVisible       Boolean  @default(false)
  facebook              String?
  facebookVisible       Boolean  @default(false)
  email                 String?
  emailVisible          Boolean  @default(false)
  phoneNumber           String?
  phoneNumberVisible    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model UserReference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  contactInfo String?
  visible     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model InventoryEntry {
  id               String @id @default(cuid())
  quantity         Int    @default(0)
  foilQuantity     Int    @default(0)
  holofoilQuantity Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}

model CardAnalysis {
  id        String   @id @default(cuid())
  cardId    String   @unique
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  analysis  String
  status    String   @default("completed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardPrice {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant     String
  lowPrice    Float?
  midPrice    Float?
  highPrice   Float?
  marketPrice Float?
  updatedAt   DateTime @updatedAt

  @@unique([cardId, variant])
}

model TcgcsvPriceSnapshotRun {
  id               Int       @id @default(autoincrement())
  categoryId       Int       @default(71)
  sourceUpdatedAt  DateTime
  status           String
  groupCount       Int       @default(0)
  successfulGroups Int       @default(0)
  failedGroups     Int       @default(0)
  rowCount         Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  errorSummary     Json?

  prices TcgcsvPriceSnapshot[]

  @@unique([categoryId, sourceUpdatedAt])
  @@index([sourceUpdatedAt])
  @@index([status])
}

model TcgcsvPriceSnapshot {
  id             Int                    @id @default(autoincrement())
  runId          Int
  run            TcgcsvPriceSnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  groupId        Int
  productId      Int
  variant        String
  lowPrice       Decimal?               @db.Decimal(12, 2)
  midPrice       Decimal?               @db.Decimal(12, 2)
  highPrice      Decimal?               @db.Decimal(12, 2)
  marketPrice    Decimal?               @db.Decimal(12, 2)
  directLowPrice Decimal?               @db.Decimal(12, 2)

  @@unique([runId, productId, variant])
  @@index([productId, variant, runId])
  @@index([runId, groupId])
}
