generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id              String   @id @default(cuid())
  externalId      Int      @unique
  tcgPlayerId     Int?
  cardTraderUrl   String?
  cardmarketUrl   String?
  displayPrice    Float?
  name            String
  subtitle        String   @default("")
  character       String?
  types           String[]
  cardType        String   @default("")
  color           String
  setCode         String
  setNumber       Int?
  setName         String
  rarity          String
  inkCost         Int      @default(0)
  strength        Int      @default(0)
  willpower       Int      @default(0)
  lore            Int      @default(0)
  abilities       String   @default("")
  cardNumber      String   @default("")
  collectorNumber Int?
  foilTypes       String[] @default([])
  imageUrl        String   @default("")

  inventoryEntries     InventoryEntry[]
  analysis             CardAnalysis?
  prices               CardPrice[]
  retentionOverrides   CardRetentionOverride[]
  extraForSaleListings ExtraForSaleListing[]
  marketplaceTransactions MarketplaceTransaction[]

  @@index([name])
  @@index([color])
  @@index([setName])
  @@index([setNumber])
  @@index([collectorNumber])
  @@index([rarity])
  @@index([tcgPlayerId])
  @@index([displayPrice])
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String
  publicEnabled   Boolean   @default(false)
  email           String?
  emailNormalized String?   @unique
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())

  inventoryEntries       InventoryEntry[]
  profile                UserProfile?
  references             UserReference[]
  inventoryPolicy        UserInventoryPolicy?
  cardRetentionOverrides CardRetentionOverride[]
  extraForSaleListings   ExtraForSaleListing[]
  marketplacePurchases   MarketplaceTransaction[] @relation("MarketplaceBuyerTransactions")
  marketplaceSales       MarketplaceTransaction[] @relation("MarketplaceSellerTransactions")
  marketplaceReviewsAuthored MarketplaceReview[] @relation("MarketplaceReviewsAuthored")
  marketplaceReviewsReceived MarketplaceReview[] @relation("MarketplaceReviewsReceived")
  marketplaceReports     MarketplaceReport[] @relation("MarketplaceReportsByUser")
  blocksCreated          UserBlock[] @relation("UserBlocksCreated")
  blocksReceived         UserBlock[] @relation("UserBlocksReceived")
}

model UserInventoryPolicy {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keepNormalQuantity   Int      @default(4)
  keepFoilQuantity     Int      @default(1)
  keepHolofoilQuantity Int      @default(1)
  autoSuggestExtras    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model CardRetentionOverride {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId               String
  card                 Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  keepNormalQuantity   Int?
  keepFoilQuantity     Int?
  keepHolofoilQuantity Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

model ExtraForSaleListing {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant         String
  desiredQuantity     Int
  note                String?
  customPrice         Float?
  customPriceCurrency String  @default("SGD")
  status              String  @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  marketplaceReservations MarketplaceReservation[]
  marketplaceTransactions MarketplaceTransaction[]

  @@unique([userId, cardId, variant])
  @@index([userId])
  @@index([cardId])
  @@index([status])
}

model MarketplaceReservation {
  id                  String   @id @default(cuid())
  listingId           String?
  listing             ExtraForSaleListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyerId             String
  sellerId            String
  quantity            Int      @default(1)
  unitPriceMinor      Int?
  shippingPriceMinor  Int?
  currency            String?
  fulfilmentMethod    String?
  buyerCountryCode    String?
  status              String   @default("ACTIVE")
  expiresAt           DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  transaction         MarketplaceTransaction?

  @@index([listingId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
  @@index([expiresAt])
}

model MarketplaceTransaction {
  id                  String   @id @default(cuid())
  reservationId       String?  @unique
  reservation         MarketplaceReservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  listingId           String?
  listing             ExtraForSaleListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyerId             String
  buyer               User     @relation("MarketplaceBuyerTransactions", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId            String
  seller              User     @relation("MarketplaceSellerTransactions", fields: [sellerId], references: [id], onDelete: Cascade)
  cardId              String?
  card                Card?    @relation(fields: [cardId], references: [id], onDelete: SetNull)
  variant             String
  quantity            Int      @default(1)
  unitPriceMinor      Int?
  shippingPriceMinor  Int?
  currency            String?
  fulfilmentMethod    String?
  buyerCountryCode    String?
  status              String   @default("AWAITING_BUYER_CONFIRMATION")
  completedAt         DateTime?
  reviewWindowEndsAt  DateTime?
  disputedAt          DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  reviews             MarketplaceReview[]

  @@index([buyerId])
  @@index([sellerId])
  @@index([cardId])
  @@index([status])
  @@index([completedAt])
}

model MarketplaceReview {
  id               String   @id @default(cuid())
  transactionId    String
  transaction      MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewerId       String
  reviewer         User     @relation("MarketplaceReviewsAuthored", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId       String
  reviewee         User     @relation("MarketplaceReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerRole     String
  rating           Int
  comment          String?
  status           String   @default("SEALED")
  moderationStatus String   @default("VISIBLE")
  submittedAt      DateTime @default(now())
  revealedAt       DateTime?
  frozenAt         DateTime?
  hiddenAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  tags             MarketplaceReviewTag[]

  @@unique([transactionId, reviewerId])
  @@index([revieweeId])
  @@index([reviewerId])
  @@index([status])
  @@index([moderationStatus])
}

model MarketplaceReviewTag {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketplaceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tag       String
  createdAt DateTime @default(now())

  @@unique([reviewId, tag])
  @@index([tag])
}

model MarketplaceReport {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("MarketplaceReportsByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  details    String?
  status     String   @default("PENDING")
  resolvedByUserId String?
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("UserBlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String?
  profileImageUrl       String?
  profileImageObjectKey String?
  countryOfResidence    String?
  instagram             String?
  instagramVisible      Boolean  @default(false)
  telegram              String?
  telegramVisible       Boolean  @default(false)
  facebook              String?
  facebookVisible       Boolean  @default(false)
  email                 String?
  emailVisible          Boolean  @default(false)
  phoneNumber           String?
  phoneNumberVisible    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model UserReference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  contactInfo String?
  visible     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model InventoryEntry {
  id               String @id @default(cuid())
  quantity         Int    @default(0)
  foilQuantity     Int    @default(0)
  holofoilQuantity Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}

model CardAnalysis {
  id        String   @id @default(cuid())
  cardId    String   @unique
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  analysis  String
  status    String   @default("completed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardPrice {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant     String
  lowPrice    Float?
  midPrice    Float?
  highPrice   Float?
  marketPrice Float?
  updatedAt   DateTime @updatedAt

  @@unique([cardId, variant])
}
