generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id               String    @id @default(cuid())
  externalId       Int       @unique
  tcgPlayerId      Int?
  cardTraderUrl    String?
  cardmarketUrl    String?
  displayPrice     Float?
  name             String
  subtitle         String    @default("")
  character        String?
  types            String[]
  cardType         String    @default("")
  color            String
  setCode          String
  setNumber        Int?
  setName          String
  rarity           String
  inkCost          Int       @default(0)
  inkable          Boolean   @default(false)
  strength         Int       @default(0)
  willpower        Int       @default(0)
  lore             Int       @default(0)
  abilities        String    @default("")
  cardNumber       String    @default("")
  collectorNumber  Int?
  foilTypes        String[]  @default([])
  imageUrl         String    @default("")
  imageObjectKey   String?
  imageCachedAt    DateTime?
  imageContentType String?

  inventoryEntries        InventoryEntry[]
  analysis                CardAnalysis?
  prices                  CardPrice[]
  retentionOverrides      CardRetentionOverride[]
  marketplaceListings     MarketplaceListing[]
  marketplaceTransactions MarketplaceTransaction[]

  @@index([name])
  @@index([color])
  @@index([inkCost])
  @@index([cardType])
  @@index([setName])
  @@index([setNumber])
  @@index([collectorNumber])
  @@index([rarity])
  @@index([tcgPlayerId])
  @@index([displayPrice])
  @@index([imageObjectKey])
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String?
  email           String?
  emailNormalized String?   @unique
  emailVerifiedAt DateTime?
  googleSub       String?   @unique
  authProvider    String    @default("LOCAL")
  publicEnabled   Boolean   @default(false)
  createdAt       DateTime  @default(now())
  isOperator      Boolean   @default(false)
  disabledAt      DateTime?

  inventoryEntries       InventoryEntry[]
  profile                UserProfile?
  inventoryPolicy        UserInventoryPolicy?
  cardRetentionOverrides CardRetentionOverride[]
  listings               MarketplaceListing[]
  enquiriesAsBuyer       MarketplaceEnquiry[]     @relation("EnquiryBuyer")
  enquiriesAsSeller      MarketplaceEnquiry[]     @relation("EnquirySeller")
  enquiryReadStates      EnquiryReadState[]
  transactionsAsBuyer    MarketplaceTransaction[] @relation("TxBuyer")
  transactionsAsSeller   MarketplaceTransaction[] @relation("TxSeller")
  reviewsWritten         MarketplaceReview[]      @relation("ReviewReviewer")
  reviewsReceived        MarketplaceReview[]      @relation("ReviewReviewee")
  referencesWritten      UserReference[]          @relation("RefAuthor")
  referencesReceived     UserReference[]          @relation("RefSubject")
  reports                MarketplaceReport[]
  enquiryMessages        EnquiryMessage[]
}

model UserInventoryPolicy {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keepNormalQuantity   Int      @default(4)
  keepFoilQuantity     Int      @default(1)
  keepHolofoilQuantity Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model CardRetentionOverride {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId               String
  card                 Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  keepNormalQuantity   Int?
  keepFoilQuantity     Int?
  keepHolofoilQuantity Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String?
  profileImageUrl       String?
  profileImageObjectKey String?
  countryOfResidence    String?
  instagram             String?
  instagramVisible      Boolean  @default(false)
  telegram              String?
  telegramVisible       Boolean  @default(false)
  facebook              String?
  facebookVisible       Boolean  @default(false)
  email                 String?
  emailVisible          Boolean  @default(false)
  phoneNumber           String?
  phoneNumberVisible    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model InventoryEntry {
  id               String @id @default(cuid())
  quantity         Int    @default(0)
  foilQuantity     Int    @default(0)
  holofoilQuantity Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}

model CardAnalysis {
  id        String   @id @default(cuid())
  cardId    String   @unique
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  analysis  String
  status    String   @default("completed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardPrice {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant     String
  lowPrice    Float?
  midPrice    Float?
  highPrice   Float?
  marketPrice Float?
  updatedAt   DateTime @updatedAt

  @@unique([cardId, variant])
}

model TcgcsvPriceSnapshotRun {
  id               Int       @id @default(autoincrement())
  categoryId       Int       @default(71)
  sourceUpdatedAt  DateTime
  status           String
  groupCount       Int       @default(0)
  successfulGroups Int       @default(0)
  failedGroups     Int       @default(0)
  rowCount         Int       @default(0)
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  errorSummary     Json?

  prices TcgcsvPriceSnapshot[]

  @@unique([categoryId, sourceUpdatedAt])
  @@index([sourceUpdatedAt])
  @@index([status])
}

model TcgcsvPriceSnapshot {
  id             Int                    @id @default(autoincrement())
  runId          Int
  run            TcgcsvPriceSnapshotRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  groupId        Int
  productId      Int
  variant        String
  lowPrice       Decimal?               @db.Decimal(12, 2)
  midPrice       Decimal?               @db.Decimal(12, 2)
  highPrice      Decimal?               @db.Decimal(12, 2)
  marketPrice    Decimal?               @db.Decimal(12, 2)
  directLowPrice Decimal?               @db.Decimal(12, 2)

  @@unique([runId, productId, variant])
  @@index([productId, variant, runId])
  @@index([runId, groupId])
}

model MarketplaceListing {
  id         String    @id @default(cuid())
  sellerId   String
  seller     User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  cardId     String
  card       Card      @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant    String // "normal" | "foil" | "holofoil"
  quantity   Int // remaining offered count
  priceMinor Int // unit price in minor units
  currency   String // ISO-4217 uppercase
  condition  String? // "NM" | "LP" | "MP" | "HP"
  location   String    @default("")
  note       String?
  status     String    @default("ACTIVE") // "ACTIVE" | "CLOSED"
  hiddenAt   DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  photos       MarketplaceListingPhoto[]
  enquiries    MarketplaceEnquiry[]
  transactions MarketplaceTransaction[]

  @@index([status, hiddenAt, variant])
  @@index([sellerId, variant])
  @@index([cardId])
  @@index([currency])
  @@index([condition])
}

model MarketplaceListingPhoto {
  id        String             @id @default(cuid())
  listingId String
  listing   MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  objectKey String
  url       String
  sortOrder Int                @default(0)
  label     String? // nullable position label (REQ-POL-15); null/empty = unlabeled
  createdAt DateTime           @default(now())

  @@index([listingId])
}

model MarketplaceEnquiry {
  id                String             @id @default(cuid())
  listingId         String
  listing           MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             User               @relation("EnquiryBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId          String // denormalized from listing for "my enquiries as seller" + authz
  seller            User               @relation("EnquirySeller", fields: [sellerId], references: [id], onDelete: Cascade)
  requestedQuantity Int
  status            String             @default("ACTIVE") // "ACTIVE" | "ARCHIVED"
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  messages     EnquiryMessage[]
  readStates   EnquiryReadState[]
  transactions MarketplaceTransaction[]

  @@unique([buyerId, listingId])
  @@index([listingId])
  @@index([sellerId])
  @@index([buyerId])
}

model EnquiryReadState {
  id         String             @id @default(cuid())
  enquiryId  String
  enquiry    MarketplaceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime           @default(now())

  @@unique([enquiryId, userId])
  @@index([userId])
}

model EnquiryMessage {
  id        String             @id @default(cuid())
  enquiryId String
  enquiry   MarketplaceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User               @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String // plain text, unmodified (AC-13.1)
  createdAt DateTime           @default(now())

  @@index([enquiryId, createdAt])
}

model MarketplaceTransaction {
  id             String             @id @default(cuid())
  enquiryId      String
  enquiry        MarketplaceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  listingId      String
  listing        MarketplaceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User               @relation("TxBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User               @relation("TxSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  cardId         String
  card           Card               @relation(fields: [cardId], references: [id], onDelete: Restrict)
  variant        String // "normal" | "foil" | "holofoil"
  quantity       Int
  priceMinor     Int // unit-price snapshot at mark-sold
  currency       String
  status         String             @default("PENDING_CONFIRMATION") // "PENDING_CONFIRMATION" | "COMPLETED" | "CANCELLED"
  completedCause String? // "BUYER_CONFIRM" | "AUTO_TRANSFER"
  cancelledBy    String? // "BUYER" | "SELLER" | "SYSTEM"
  soldAt         DateTime           @default(now())
  confirmedAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  reviews MarketplaceReview[]

  @@index([sellerId, cardId, variant, status])
  @@index([buyerId, status])
  @@index([status, soldAt]) // auto-transfer sweep
  @@index([listingId])
}

model MarketplaceReview {
  id            String                 @id @default(cuid())
  transactionId String
  transaction   MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User                   @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId    String
  reviewee      User                   @relation("ReviewReviewee", fields: [revieweeId], references: [id], onDelete: Cascade)
  rating        Int // 1..5 (CHECK in migration)
  comment       String?
  createdAt     DateTime               @default(now())

  @@unique([transactionId, reviewerId])
  @@index([revieweeId])
}

model UserReference {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation("RefAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  subjectId String
  subject   User     @relation("RefSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One vouch per (author, subject): a new vouch upserts and replaces the prior
  // (AC-20.2). No transactionId — a vouch is a free-form reference check, distinct
  // from transaction-linked reviews. The "completed deal" indication is computed at
  // read time (AC-21.2), never stored.
  @@unique([authorId, subjectId])
  @@index([subjectId])
}

model MarketplaceReport {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String // "LISTING" | "USER"
  targetId   String
  reason     String
  status     String   @default("OPEN") // "OPEN" | "RESOLVED"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, targetType])
  @@index([targetType, targetId])
}
