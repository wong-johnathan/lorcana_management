generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id            String   @id @default(cuid())
  externalId    Int      @unique
  tcgPlayerId   Int?
  cardTraderUrl String?
  cardmarketUrl String?
  displayPrice  Float?
  name          String
  subtitle      String   @default("")
  character     String?
  types         String[]
  cardType      String   @default("")
  color         String
  setCode       String
  setName       String
  rarity        String
  inkCost       Int      @default(0)
  strength      Int      @default(0)
  willpower     Int      @default(0)
  lore          Int      @default(0)
  abilities     String   @default("")
  cardNumber    String   @default("")
  imageUrl      String   @default("")

  inventoryEntries InventoryEntry[]
  analysis         CardAnalysis?
  prices           CardPrice[]

  @@index([name])
  @@index([color])
  @@index([setName])
  @@index([rarity])
  @@index([tcgPlayerId])
  @@index([displayPrice])
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  passwordHash  String
  publicEnabled Boolean  @default(false)
  createdAt     DateTime @default(now())

  inventoryEntries InventoryEntry[]
}

model InventoryEntry {
  id           String @id @default(cuid())
  quantity     Int    @default(0)
  foilQuantity Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}

model CardAnalysis {
  id        String   @id @default(cuid())
  cardId    String   @unique
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  analysis  String
  status    String   @default("completed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardPrice {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant     String
  lowPrice    Float?
  midPrice    Float?
  highPrice   Float?
  marketPrice Float?
  updatedAt   DateTime @updatedAt

  @@unique([cardId, variant])
}
