generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Card {
  id              String   @id @default(cuid())
  externalId      Int      @unique
  tcgPlayerId     Int?
  cardTraderUrl   String?
  cardmarketUrl   String?
  displayPrice    Float?
  name            String
  subtitle        String   @default("")
  character       String?
  types           String[]
  cardType        String   @default("")
  color           String
  setCode         String
  setNumber       Int?
  setName         String
  rarity          String
  inkCost         Int      @default(0)
  strength        Int      @default(0)
  willpower       Int      @default(0)
  lore            Int      @default(0)
  abilities       String   @default("")
  cardNumber      String   @default("")
  collectorNumber Int?
  foilTypes       String[] @default([])
  imageUrl        String   @default("")

  inventoryEntries       InventoryEntry[]
  analysis               CardAnalysis?
  prices                 CardPrice[]
  retentionOverrides     CardRetentionOverride[]
  extraForSaleListings   ExtraForSaleListing[]
  marketplaceTransactions MarketplaceTransaction[]

  @@index([name])
  @@index([color])
  @@index([setName])
  @@index([setNumber])
  @@index([collectorNumber])
  @@index([rarity])
  @@index([tcgPlayerId])
  @@index([displayPrice])
}

model User {
  id              String    @id @default(cuid())
  username        String    @unique
  passwordHash    String?
  email           String?
  emailNormalized String?   @unique
  emailVerifiedAt DateTime?
  googleSub       String?   @unique
  authProvider    String    @default("LOCAL")
  publicEnabled   Boolean   @default(false)
  createdAt       DateTime  @default(now())

  inventoryEntries       InventoryEntry[]
  profile                UserProfile?
  references             UserReference[]
  inventoryPolicy        UserInventoryPolicy?
  cardRetentionOverrides CardRetentionOverride[]
  extraForSaleListings   ExtraForSaleListing[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  marketplaceEnquiries    MarketplaceEnquiry[] @relation("MarketplaceBuyerEnquiries")
  enquiryMessages         EnquiryMessage[] @relation("MarketplaceMessageSender")
  enquiryOffers           EnquiryOffer[] @relation("MarketplaceOfferProposer")
  notifications           Notification[]
  marketplaceTransactionsAsSeller MarketplaceTransaction[] @relation("MarketplaceTransactionSeller")
  marketplaceTransactionsAsBuyer  MarketplaceTransaction[] @relation("MarketplaceTransactionBuyer")
  marketplaceReviewsAuthored MarketplaceReview[] @relation("MarketplaceReviewsAuthored")
  marketplaceReviewsReceived MarketplaceReview[] @relation("MarketplaceReviewsReceived")
  marketplaceReports     MarketplaceReport[] @relation("MarketplaceReportsByUser")
  blocksCreated          UserBlock[] @relation("UserBlocksCreated")
  blocksReceived         UserBlock[] @relation("UserBlocksReceived")
}

model EmailVerificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model UserInventoryPolicy {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keepNormalQuantity   Int      @default(4)
  keepFoilQuantity     Int      @default(1)
  keepHolofoilQuantity Int      @default(1)
  autoSuggestExtras    Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([userId])
}

model CardRetentionOverride {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId               String
  card                 Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  keepNormalQuantity   Int?
  keepFoilQuantity     Int?
  keepHolofoilQuantity Int?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, cardId])
  @@index([userId])
  @@index([cardId])
}

model ExtraForSaleListing {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId          String
  card            Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant         String
  desiredQuantity     Int
  note                String?
  customPrice         Float?
  customPriceCurrency String  @default("SGD")
  marketplaceVisible  Boolean @default(false)
  pricingMode         String  @default("FIXED")
  askingPriceMinor    Int?
  currency            String?
  condition           String?
  cardLanguage        String?
  originCountryCode   String?
  publicLocality      String?
  allowsMeetup        Boolean @default(false)
  shipsDomestically   Boolean @default(false)
  shipsInternationally Boolean @default(false)
  shipsWorldwide      Boolean @default(false)
  status              String  @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  destinationCountries ListingDestinationCountry[]
  marketplaceEnquiries MarketplaceEnquiry[]
  marketplaceReservations MarketplaceReservation[]

  @@unique([userId, cardId, variant])
  @@index([userId])
  @@index([cardId])
  @@index([status])
  @@index([marketplaceVisible, status])
  @@index([currency])
  @@index([condition])
  @@index([originCountryCode])
}

model ListingDestinationCountry {
  id          String              @id @default(cuid())
  listingId   String
  listing     ExtraForSaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  countryCode String
  createdAt   DateTime            @default(now())

  @@unique([listingId, countryCode])
  @@index([countryCode])
}

model MarketplaceEnquiry {
  id             String              @id @default(cuid())
  listingId      String
  listing        ExtraForSaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId        String
  buyer          User                @relation("MarketplaceBuyerEnquiries", fields: [buyerId], references: [id], onDelete: Cascade)
  status         String              @default("PENDING_SELLER")
  lastActivityAt DateTime            @default(now())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  messages    EnquiryMessage[]
  offers      EnquiryOffer[]
  reservation MarketplaceReservation?

  @@index([listingId])
  @@index([buyerId])
  @@index([status])
  @@index([lastActivityAt])
}

model EnquiryMessage {
  id        String             @id @default(cuid())
  enquiryId String
  enquiry   MarketplaceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User               @relation("MarketplaceMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  message   String
  createdAt DateTime           @default(now())

  @@index([enquiryId])
  @@index([senderId])
  @@index([createdAt])
}

model EnquiryOffer {
  id                 String             @id @default(cuid())
  enquiryId          String
  enquiry            MarketplaceEnquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  proposedByUserId   String
  proposedByUser     User               @relation("MarketplaceOfferProposer", fields: [proposedByUserId], references: [id], onDelete: Cascade)
  quantity           Int
  unitPriceMinor     Int
  shippingPriceMinor Int                @default(0)
  currency           String
  fulfilmentMethod   String
  buyerCountryCode   String?
  createdAt          DateTime           @default(now())

  reservation MarketplaceReservation?

  @@index([enquiryId])
  @@index([proposedByUserId])
}

model MarketplaceReservation {
  id                 String              @id @default(cuid())
  listingId          String
  listing            ExtraForSaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  enquiryId          String              @unique
  enquiry            MarketplaceEnquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  acceptedOfferId    String?             @unique
  acceptedOffer      EnquiryOffer?       @relation(fields: [acceptedOfferId], references: [id], onDelete: SetNull)
  quantity           Int
  unitPriceMinor     Int
  shippingPriceMinor Int                 @default(0)
  currency           String
  fulfilmentMethod   String
  buyerCountryCode   String?
  expiresAt          DateTime
  status             String              @default("RESERVED")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  transaction MarketplaceTransaction?

  @@index([listingId])
  @@index([status])
  @@index([expiresAt])
}

model MarketplaceTransaction {
  id                        String                 @id @default(cuid())
  reservationId             String                 @unique
  reservation               MarketplaceReservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  sellerId                  String
  seller                    User                   @relation("MarketplaceTransactionSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId                   String
  buyer                     User                   @relation("MarketplaceTransactionBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  cardId                    String?
  card                      Card?                  @relation(fields: [cardId], references: [id], onDelete: SetNull)
  cardName                  String
  cardSubtitle              String?
  cardNumber                String
  cardImageUrl              String?
  variant                   String
  quantity                  Int
  agreedUnitPriceMinor      Int
  agreedShippingPriceMinor  Int                    @default(0)
  currency                  String
  fulfilmentMethod          String
  buyerCountryCode          String?
  status                    String                 @default("AWAITING_BUYER_CONFIRMATION")
  completedAt               DateTime?
  reviewWindowEndsAt        DateTime?
  disputedAt                DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt

  reviews MarketplaceReview[]

  @@index([sellerId])
  @@index([buyerId])
  @@index([cardId])
  @@index([status])
  @@index([completedAt])
}

model MarketplaceReview {
  id               String   @id @default(cuid())
  transactionId    String
  transaction      MarketplaceTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  reviewerId       String
  reviewer         User     @relation("MarketplaceReviewsAuthored", fields: [reviewerId], references: [id], onDelete: Cascade)
  revieweeId       String
  reviewee         User     @relation("MarketplaceReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewerRole     String
  rating           Int
  comment          String?
  status           String   @default("SEALED")
  moderationStatus String   @default("VISIBLE")
  submittedAt      DateTime @default(now())
  revealedAt       DateTime?
  frozenAt         DateTime?
  hiddenAt         DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tags MarketplaceReviewTag[]

  @@unique([transactionId, reviewerId])
  @@index([revieweeId])
  @@index([reviewerId])
  @@index([status])
  @@index([moderationStatus])
}

model MarketplaceReviewTag {
  id        String   @id @default(cuid())
  reviewId  String
  review    MarketplaceReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  tag       String
  createdAt DateTime @default(now())

  @@unique([reviewId, tag])
  @@index([tag])
}

model MarketplaceReport {
  id         String   @id @default(cuid())
  reporterId String
  reporter   User     @relation("MarketplaceReportsByUser", fields: [reporterId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  reason     String
  details    String?
  status     String   @default("PENDING")
  resolvedByUserId String?
  resolution String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([reporterId])
  @@index([targetType, targetId])
  @@index([status])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("UserBlocksCreated", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("UserBlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  relatedType String?
  relatedId   String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model FxRate {
  id            String   @id @default(cuid())
  baseCurrency  String
  quoteCurrency String
  rate          Decimal  @db.Decimal(18, 8)
  source        String
  fetchedAt     DateTime
  createdAt     DateTime @default(now())

  @@unique([baseCurrency, quoteCurrency, source])
  @@index([fetchedAt])
}

model UserProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName           String?
  profileImageUrl       String?
  profileImageObjectKey String?
  countryOfResidence    String?
  instagram             String?
  instagramVisible      Boolean  @default(false)
  telegram              String?
  telegramVisible       Boolean  @default(false)
  facebook              String?
  facebookVisible       Boolean  @default(false)
  email                 String?
  emailVisible          Boolean  @default(false)
  phoneNumber           String?
  phoneNumberVisible    Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId])
}

model UserReference {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  contactInfo String?
  visible     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model InventoryEntry {
  id               String @id @default(cuid())
  quantity         Int    @default(0)
  foilQuantity     Int    @default(0)
  holofoilQuantity Int    @default(0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cardId String
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId])
}

model CardAnalysis {
  id        String   @id @default(cuid())
  cardId    String   @unique
  card      Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  analysis  String
  status    String   @default("completed")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CardPrice {
  id          String   @id @default(cuid())
  cardId      String
  card        Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
  variant     String
  lowPrice    Float?
  midPrice    Float?
  highPrice   Float?
  marketPrice Float?
  updatedAt   DateTime @updatedAt

  @@unique([cardId, variant])
}
